def load_csv(
    path: str
) -> pd.DataFrame:

    if not os.path.exists(path):

        raise FileNotFoundError(
            f"\nFile tidak ditemukan:\n{path}"
        )

    df = pd.read_csv(
        path
    )

    df.columns = [
        str(c)
        .lower()
        .strip()
        for c in df.columns
    ]

    required = [
        "time",
        "open",
        "high",
        "low",
        "close"
    ]

    missing = [
        c
        for c in required
        if c not in df.columns
    ]

    if missing:

        raise ValueError(
            f"{path}\n"
            f"Kolom hilang: {missing}"
        )

    df["time"] = pd.to_datetime(
        df["time"],
        errors="coerce"
    )

    for col in [
        "open",
        "high",
        "low",
        "close"
    ]:

        df[col] = pd.to_numeric(
            df[col],
            errors="coerce"
        )

    df = (
        df
        .dropna(
            subset=[
                "time",
                "open",
                "high",
                "low",
                "close"
            ]
        )
        .sort_values(
            "time"
        )
        .drop_duplicates(
            "time"
        )
        .reset_index(
            drop=True
        )
    )

    return df


