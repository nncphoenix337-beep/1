# ================================================================
# M5 COMPLETE CONFIRMATION
# ================================================================

def confirm_m5(
    m5,
    zone,
    direction,
    current_idx
):

    # ------------------------------------------------
    # Zone must exist and remain fresh
    # ------------------------------------------------

    if int(
        zone.created_idx
    ) > current_idx:

        return None

    if not zone_is_active_at(
        zone,
        current_idx
    ):

        return None

    # ------------------------------------------------
    # Search first valid touch
    # ------------------------------------------------

    start = (
        int(zone.created_idx)
        + 1
    )

    end = min(
        int(current_idx),
        start
        +
        150
    )

    touch = None

    touch_overlap = 0.0

    for i in range(
        start,
        end + 1
    ):

        row = m5.df.iloc[
            i
        ]

        touched, overlap = (
            zone_intersects_row(
                zone,
                row
            )
        )

        if not touched:

            continue

        high = float(
            row["high"]
        )

        low = float(
            row["low"]
        )

        close = float(
            row["close"]
        )

        candle_range = (
            high - low
        )

        zone_height = max(
            float(zone.high)
            -
            float(zone.low),
            0.01
        )

        max_range = max(
            MAX_TOUCH_RANGE_ABSOLUTE,
            zone_height
            *
            MAX_TOUCH_RANGE_MULTIPLIER
        )

        if (
            candle_range
            >
            max_range
        ):

            continue

        close_distance = (
            zone_distance_to_price(
                zone,
                close
            )
        )

        max_close_distance = max(
            MAX_TOUCH_CLOSE_DISTANCE_ABSOLUTE,
            zone_height
            *
            MAX_TOUCH_CLOSE_DISTANCE_MULTIPLIER
        )

        if (
            close_distance
            >
            max_close_distance
        ):

            continue

        touch = i

        touch_overlap = overlap

        break

    if touch is None:

        return None

    # ------------------------------------------------
    # M5 sweep
    # ------------------------------------------------

    sweep = find_m5_sweep(
        m5,
        touch,
        direction,
        current_idx,
        zone
    )

    if sweep is None:

        return None

    # ------------------------------------------------
    # M5 structure
    # ------------------------------------------------

    structure = find_m5_structure(
        m5,
        sweep,
        direction,
        current_idx
    )

    if structure is None:

        return None

    structure_row = m5.df.iloc[
        int(structure.idx)
    ]

    structure_distance = (
        zone_distance_to_row(
            zone,
            structure_row
        )
    )

    if (
        structure_distance
        >
        MAX_M5_DISTANCE_FROM_POI
    ):

        return None

    # ------------------------------------------------
    # M5 displacement
    # ------------------------------------------------

    displacement = find_m5_displacement(
        m5,
        structure,
        direction,
        current_idx
    )

    if displacement is None:

        return None

    displacement_row = m5.df.iloc[
        int(displacement)
    ]

    displacement_distance = (
        zone_distance_to_row(
            zone,
            displacement_row
        )
    )

    if (
        displacement_distance
        >
        MAX_M5_DISTANCE_FROM_POI
    ):

        return None

    # ------------------------------------------------
    # Retest
    # ------------------------------------------------

    retest = find_m5_retest(
        m5,
        displacement,
        zone,
        direction,
        current_idx
    )

    if retest is None:

        return None

    return {
        "touch":
            touch,

        "touch_overlap":
            touch_overlap,

        "sweep":
            sweep,

        "structure":
            structure,

        "displacement":
            displacement,

        "retest":
            retest
    }


# ================================================================
# NEXT LIQUIDITY
# ================================================================

def next_liquidity(
    m15,
    direction,
    entry,
    current_idx
):

    candidates = []

    for pool in m15.liquidity:

        if getattr(
            pool,
            "consumed",
            False
        ):

            continue

        # Pool must already exist
        if int(
            pool.start_idx
        ) > current_idx:

            continue

        price = float(
            pool.price
        )

        if direction == "BUY":

            if price > entry:

                candidates.append(
                    price
                )

        else:

            if price < entry:

                candidates.append(
                    price
                )

    if direction == "BUY":

        if candidates:

            return min(
                candidates
            )

        return entry + (
            3.0
        )

    else:

        if candidates:

            return max(
                candidates
            )

        return entry - (
            3.0
        )


# ================================================================
# CREATE TRADE
# ================================================================

def create_trade(
    trade_id,
    direction,
    signal_time,
    m5,
    m15,
    candidate,
    confirmation
):

    retest_idx = int(
        confirmation[
            "retest"
        ]
    )

    retest_row = m5.df.iloc[
        retest_idx
    ]

    entry = float(
        retest_row["close"]
    )

    sweep_idx = int(
        confirmation[
            "sweep"
        ]
    )

    sweep_row = m5.df.iloc[
        sweep_idx
    ]

    # ------------------------------------------------
    # SL
    # ------------------------------------------------

    if direction == "BUY":

        sweep_price = float(
            sweep_row["low"]
        )

        sl = (
            sweep_price
            -
            SL_BUFFER
        )

    else:

        sweep_price = float(
            sweep_row["high"]
        )

        sl = (
            sweep_price
            +
            SL_BUFFER
        )

    risk = abs(
        entry - sl
    )

    if (
        risk < MIN_RISK
        or
        risk > MAX_RISK
    ):

        return None

    # ------------------------------------------------
    # TP
    # ------------------------------------------------

    if direction == "BUY":

        tp1 = (
            entry
            +
            risk * TP1_R
        )

        tp2 = (
            entry
            +
            risk * TP2_R
        )

        liquidity = next_liquidity(
            m15,
            direction,
            entry,
            retest_idx
        )

        tp3 = max(
            tp2,
            liquidity
        )

    else:

        tp1 = (
            entry
            -
            risk * TP1_R
        )

        tp2 = (
            entry
            -
            risk * TP2_R
        )

        liquidity = next_liquidity(
            m15,
            direction,
            entry,
            retest_idx
        )

        tp3 = min(
            tp2,
            liquidity
        )

    # ------------------------------------------------
    # M15 info
    # ------------------------------------------------

    m15_sweep = candidate[
        "sweep"
    ]

    m15_structure = candidate[
        "structure"
    ]

    displacement_idx = candidate[
        "displacement"
    ]

    poi = candidate[
        "poi"
    ]

    m5_structure = confirmation[
        "structure"
    ]

    return Trade(

        trade_id=trade_id,

        direction=direction,

        signal_time=pd.Timestamp(
            signal_time
        ),

        entry_time=pd.Timestamp(
            retest_row["time"]
        ),

        entry=entry,

        sl=sl,

        tp1=tp1,

        tp2=tp2,

        tp3=tp3,

        risk=risk,

        m15_sweep_time=pd.Timestamp(
            m15.df.iloc[
                int(m15_sweep.idx)
            ]["time"]
        ),

        m15_structure_time=pd.Timestamp(
            m15.df.iloc[
                int(m15_structure.idx)
            ]["time"]
        ),

        m15_structure_event=str(
            m15_structure.event
        ),

        m15_displacement_time=pd.Timestamp(
            m15.df.iloc[
                displacement_idx
            ]["time"]
        ),

        poi_type=str(
            poi.zone_type
        ),

        poi_low=float(
            poi.low
        ),

        poi_high=float(
            poi.high
        ),

        m5_touch_time=pd.Timestamp(
            m5.df.iloc[
                int(
                    confirmation["touch"]
                )
            ]["time"]
        ),

        m5_sweep_time=pd.Timestamp(
            m5.df.iloc[
                sweep_idx
            ]["time"]
        ),

        m5_structure_time=pd.Timestamp(
            m5.df.iloc[
                int(
                    m5_structure.idx
                )
            ]["time"]
        ),

        m5_structure_event=str(
            m5_structure.event
        ),

        m5_displacement_time=pd.Timestamp(
            m5.df.iloc[
                int(
                    confirmation["displacement"]
                )
            ]["time"]
        ),

        m5_retest_time=pd.Timestamp(
            retest_row["time"]
        )
    )


# ================================================================
# SIMULATE TRADE
# ================================================================

def simulate_trade(
    trade,
    m5,
    start_idx
):

    current_sl = float(
        trade.sl
    )

    remaining_1 = PARTIAL_1

    remaining_2 = PARTIAL_2

    remaining_3 = PARTIAL_3

    result_r = 0.0

    bars = 0

    for i in range(
        start_idx,
        min(
            len(m5.df),
            start_idx
            +
            MAX_HOLD_M5_BARS
        )
    ):

        bars += 1

        row = m5.df.iloc[
            i
        ]

        high = float(
            row["high"]
        )

        low = float(
            row["low"]
        )

        current_time = (
            row["time"]
        )

        # ========================================================
        # BUY
        # ========================================================

        if trade.direction == "BUY":

            # ------------------------------------------------
            # BEFORE TP1
            # ------------------------------------------------

            if not trade.tp1_hit:

                # Conservative rule:
                # if both SL and TP are touched in the same
                # candle, SL is considered first.

                if low <= current_sl:

                    result_r += (
                        -1.0
                    )

                    trade.sl_hit = True

                    trade.sl_time = (
                        current_time
                    )

                    trade.exit_time = (
                        current_time
                    )

                    trade.status = "SL"

                    break

                if high >= trade.tp1:

                    result_r += (
                        TP1_R
                        *
                        PARTIAL_1
                    )

                    trade.tp1_hit = True

                    trade.tp1_time = (
                        current_time
                    )

                    current_sl = (
                        trade.entry
                    )

            # ------------------------------------------------
            # TP2
            # ------------------------------------------------

            if (
                trade.tp1_hit
                and
                not trade.tp2_hit
            ):

                if low <= current_sl:

                    trade.exit_time = (
                        current_time
                    )

                    trade.status = "BE"

                    trade.sl_time = (
                        current_time
                    )

                    break

                if high >= trade.tp2:

                    result_r += (
                        TP2_R
                        *
                        PARTIAL_2
                    )

                    trade.tp2_hit = True

                    trade.tp2_time = (
                        current_time
                    )

                    remaining_2 = 0.0

            # ------------------------------------------------
            # TP3
            # ------------------------------------------------

            if (
                trade.tp2_hit
                and
                not trade.tp3_hit
            ):

                if low <= current_sl:

                    trade.exit_time = (
                        current_time
                    )

                    trade.status = "BE"

                    break

                if high >= trade.tp3:

                    result_r += (
                        TP3_R
                        *
                        PARTIAL_3
                    )

                    trade.tp3_hit = True

                    trade.tp3_time = (
                        current_time
                    )

                    trade.exit_time = (
                        current_time
                    )

                    trade.status = "TP3"

                    break

        # ========================================================
        # SELL
        # ========================================================

        else:

            # ------------------------------------------------
            # BEFORE TP1
            # ------------------------------------------------

            if not trade.tp1_hit:

                if high >= current_sl:

                    result_r += (
                        -1.0
                    )

                    trade.sl_hit = True

                    trade.sl_time = (
                        current_time
                    )

                    trade.exit_time = (
                        current_time
                    )

                    trade.status = "SL"

                    break

                if low <= trade.tp1:

                    result_r += (
                        TP1_R
                        *
                        PARTIAL_1
                    )

                    trade.tp1_hit = True

                    trade.tp1_time = (
                        current_time
                    )

                    current_sl = (
                        trade.entry
                    )

            # ------------------------------------------------
            # TP2
            # ------------------------------------------------

            if (
                trade.tp1_hit
                and
                not trade.tp2_hit
            ):

                if high >= current_sl:

                    trade.exit_time = (
                        current_time
                    )

                    trade.status = "BE"

                    trade.sl_time = (
                        current_time
                    )

                    break

                if low <= trade.tp2:

                    result_r += (
                        TP2_R
                        *
                        PARTIAL_2
                    )

                    trade.tp2_hit = True

                    trade.tp2_time = (
                        current_time
                    )

                    remaining_2 = 0.0

            # ------------------------------------------------
            # TP3
            # ------------------------------------------------

            if (
                trade.tp2_hit
                and
                not trade.tp3_hit
            ):

                if high >= current_sl:

                    trade.exit_time = (
                        current_time
                    )

                    trade.status = "BE"

                    break

                if low <= trade.tp3:

                    result_r += (
                        TP3_R
                        *
                        PARTIAL_3
                    )

                    trade.tp3_hit = True

                    trade.tp3_time = (
                        current_time
                    )

                    trade.exit_time = (
                        current_time
                    )

                    trade.status = "TP3"

                    break

        # --------------------------------------------------------
        # FULL TP1 + TP2 but no TP3
        # --------------------------------------------------------

        if (
            trade.tp1_hit
            and
            trade.tp2_hit
            and
            trade.tp3_hit
        ):

            break

    else:

        # ========================================================
        # TIMEOUT
        # ========================================================

        last_idx = min(
            len(m5.df) - 1,
            start_idx
            +
            MAX_HOLD_M5_BARS
            -
            1
        )

        row = m5.df.iloc[
            last_idx
        ]

        exit_price = float(
            row["close"]
        )

        remaining = (
            PARTIAL_1
            if not trade.tp1_hit
            else 0.0
        )

        if trade.tp1_hit and not trade.tp2_hit:

            remaining = PARTIAL_2 + PARTIAL_3

        elif trade.tp2_hit and not trade.tp3_hit:

            remaining = PARTIAL_3

        if remaining > 0:

            if trade.direction == "BUY":

                result_r += (
                    (
                        exit_price
                        -
                        trade.entry
                    )
                    /
                    trade.risk
                ) * remaining

            else:

                result_r += (
                    (
                        trade.entry
                        -
                        exit_price
                    )
                    /
                    trade.risk
                ) * remaining

        trade.exit_time = (
            row["time"]
        )

        trade.status = "TIMEOUT"

    trade.result_r = float(
        result_r
    )

    trade.bars_held = bars

    return trade


