# ================================================================
# ZONE STATE AT REPLAY INDEX
# ================================================================

def zone_is_active_at(
    zone,
    current_idx
):

    created = int(
        zone.created_idx
    )

    if created > current_idx:

        return False

    # Invalidated in the future:
    # still active now.
    invalidated = getattr(
        zone,
        "invalidated_idx",
        None
    )

    if invalidated is not None:

        if int(invalidated) <= current_idx:

            return False

    # Mitigated zone is NOT fresh.
    mitigated = getattr(
        zone,
        "mitigated_idx",
        None
    )

    if mitigated is not None:

        if int(mitigated) <= current_idx:

            return False

    return True


# ================================================================
# ZONE INTERSECTION
# ================================================================

def zone_intersects_row(
    zone,
    row
):

    high = float(
        row["high"]
    )

    low = float(
        row["low"]
    )

    overlap = (
        min(
            high,
            float(zone.high)
        )
        -
        max(
            low,
            float(zone.low)
        )
    )

    return (
        overlap > MIN_ZONE_OVERLAP,
        max(
            0.0,
            overlap
        )
    )


# ================================================================
# ZONE DISTANCE TO CANDLE
# ================================================================

def zone_distance_to_row(
    zone,
    row
):

    high = float(
        row["high"]
    )

    low = float(
        row["low"]
    )

    if high < zone.low:

        return (
            float(zone.low)
            -
            high
        )

    if low > zone.high:

        return (
            low
            -
            float(zone.high)
        )

    return 0.0


# ================================================================
# ZONE DISTANCE TO PRICE
# ================================================================

def zone_distance_to_price(
    zone,
    price
):

    price = float(
        price
    )

    if price < zone.low:

        return (
            float(zone.low)
            -
            price
        )

    if price > zone.high:

        return (
            price
            -
            float(zone.high)
        )

    return 0.0


# ================================================================
# VALID POI
# ================================================================

def valid_poi(
    zone,
    displacement_idx,
    direction,
    m15
):

    if zone is None:

        return False

    # Direction
    if zone.direction != direction:

        return False

    # Must already exist
    if int(zone.created_idx) < int(
        displacement_idx
    ):

        return False

    if int(zone.created_idx) > (
        int(displacement_idx)
        +
        MAX_M15_POI_AFTER_DISPLACEMENT
    ):

        return False

    # Fresh at displacement time
    if not zone_is_active_at(
        zone,
        displacement_idx
    ):

        return False

    drow = m15.df.iloc[
        displacement_idx
    ]

    distance = zone_distance_to_row(
        zone,
        drow
    )

    if (
        distance
        >
        MAX_POI_DISPLACEMENT_GAP
    ):

        return False

    close = float(
        drow["close"]
    )

    # Directional relationship
    if direction == "BUY":

        if close < float(
            zone.low
        ):

            return False

    else:

        if close > float(
            zone.high
        ):

            return False

    # Source candle sanity
    source_idx = int(
        getattr(
            zone,
            "source_idx",
            -999999
        )
    )

    if source_idx < 0:

        return False

    if (
        abs(
            source_idx
            -
            displacement_idx
        )
        >
        8
    ):

        return False

    return True


# ================================================================
# FIND POI AT REPLAY TIME
# ================================================================

def find_poi_at(
    m15,
    displacement_idx,
    direction,
    current_idx
):

    candidates = []

    for zone in m15.zones:

        if not valid_poi(
            zone,
            displacement_idx,
            direction,
            m15
        ):

            continue

        # POI must exist now
        if int(
            zone.created_idx
        ) > current_idx:

            continue

        # Must still be fresh
        if not zone_is_active_at(
            zone,
            current_idx
        ):

            continue

        distance = zone_distance_to_row(
            zone,
            m15.df.iloc[
                displacement_idx
            ]
        )

        candidates.append(
            (
                distance,
                -int(
                    zone.created_idx
                ),
                zone
            )
        )

    if not candidates:

        return None

    candidates.sort(
        key=lambda x: (
            x[0],
            x[1]
        )
    )

    return candidates[0][2]


# ================================================================
# M15 STRUCTURE AFTER SWEEP
# ================================================================

def find_m15_structure(
    m15,
    sweep,
    direction,
    current_idx
):

    if direction == "BUY":

        valid = {
            "CHoCH_UP",
            "BOS_UP",
            "INITIAL_BOS_UP"
        }

        opposite = {
            "CHoCH_DOWN",
            "BOS_DOWN",
            "INITIAL_BOS_DOWN"
        }

    else:

        valid = {
            "CHoCH_DOWN",
            "BOS_DOWN",
            "INITIAL_BOS_DOWN"
        }

        opposite = {
            "CHoCH_UP",
            "BOS_UP",
            "INITIAL_BOS_UP"
        }

    start = int(
        sweep.idx
    ) + 1

    end = min(
        int(current_idx),
        int(sweep.idx)
        +
        MAX_M15_STRUCTURE_AFTER_SWEEP
    )

    candidates = [
        event
        for event in m15.structure
        if (
            event.event in valid
            and
            start <= int(event.idx) <= end
        )
    ]

    if not candidates:

        return None

    candidate = min(
        candidates,
        key=lambda x: int(x.idx)
    )

    # Opposite structure before candidate
    for event in m15.structure:

        if (
            event.event in opposite
            and
            int(sweep.idx)
            <
            int(event.idx)
            <
            int(candidate.idx)
            and
            int(event.idx) <= end
        ):

            return None

    return candidate


# ================================================================
# M15 DISPLACEMENT
# ================================================================

def find_m15_displacement(
    m15,
    structure,
    direction,
    current_idx
):

    start = (
        int(structure.idx)
        + 1
    )

    end = min(
        int(current_idx),
        start
        +
        MAX_M15_DISPLACEMENT_AFTER_STRUCTURE
        -
        1
    )

    if end < start:

        return None

    for i in range(
        start,
        end + 1
    ):

        if m15.is_displacement(
            i,
            direction
        ):

            return i

    return None


# ================================================================
# BUILD M15 CANDIDATES
# ================================================================

def build_m15_candidates(
    m15,
    direction,
    current_idx
):

    if direction == "BUY":

        sweep_name = (
            "LIQUIDITY_SWEEP_LOW"
        )

    else:

        sweep_name = (
            "LIQUIDITY_SWEEP_HIGH"
        )

    sweeps = [
        event
        for event in m15.events
        if (
            event.event == sweep_name
            and
            int(event.idx)
            <= current_idx
        )
    ]

    sweeps.sort(
        key=lambda x: int(x.idx),
        reverse=True
    )

    candidates = []

    for sweep in sweeps:

        structure = find_m15_structure(
            m15,
            sweep,
            direction,
            current_idx
        )

        if structure is None:

            continue

        displacement = find_m15_displacement(
            m15,
            structure,
            direction,
            current_idx
        )

        if displacement is None:

            # Important:
            # DO NOT block older candidates.
            continue

        poi = find_poi_at(
            m15,
            displacement,
            direction,
            current_idx
        )

        if poi is None:

            continue

        candidates.append(
            {
                "direction":
                    direction,

                "sweep":
                    sweep,

                "structure":
                    structure,

                "displacement":
                    displacement,

                "poi":
                    poi
            }
        )

    return candidates


# ================================================================
# M5 LOCAL SWEEP
# ================================================================

def find_m5_sweep(
    m5,
    touch_idx,
    direction,
    current_idx,
    zone
):

    start = (
        int(touch_idx)
        + 1
    )

    end = min(
        int(current_idx),
        int(touch_idx)
        +
        MAX_M5_CONFIRM_BARS
    )

    if end < start:

        return None

    for i in range(
        start,
        end + 1
    ):

        row = m5.df.iloc[
            i
        ]

        touched, _ = zone_intersects_row(
            zone,
            row
        )

        if not touched:

            continue

        lookback_start = max(
            0,
            i
            -
            MAX_M5_LOCAL_LOOKBACK
        )

        previous = m5.df.iloc[
            lookback_start:i
        ]

        if previous.empty:

            continue

        previous_high = float(
            previous["high"].max()
        )

        previous_low = float(
            previous["low"].min()
        )

        high = float(
            row["high"]
        )

        low = float(
            row["low"]
        )

        close = float(
            row["close"]
        )

        # SELL:
        # buy-side liquidity sweep
        if direction == "SELL":

            if (
                high > previous_high
                and
                close < previous_high
            ):

                return i

        # BUY:
        # sell-side liquidity sweep
        else:

            if (
                low < previous_low
                and
                close > previous_low
            ):

                return i

    return None


