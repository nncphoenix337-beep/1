                f" M5 STRUCTURE : "
                f"{event.event} "
                f"@ "
                f"{fmt_time(event.time)} "
                f"Price "
                f"{fmt_price(event.price)}"
            )

    displacement_idx = m5.get(
        "displacement"
    )

    if displacement_idx is not None:

        print(
            " M5 DISPLACE : "
            +
            fmt_displacement(
                m5_engine,
                displacement_idx,
                direction
            )
        )

    retest = m5.get(
        "retest"
    )

    if retest is not None:

        row = m5_engine.df.iloc[
            int(retest)
        ]

        print(
            f" M5 RETEST   : "
            f"{fmt_time(row['time'])} "
            f"@ "
            f"{fmt_price(row['close'])}"
        )


# ================================================================
# PRINT EVENTS
# ================================================================

def print_last_events(
    engine,
    count=15
):

    print()
    print(
        f"===== "
        f"{engine.timeframe} "
        f"LAST {count} EVENTS "
        f"====="
    )

    events = engine.events[
        -count:
    ]

    if not events:

        print(
            "No events."
        )

        return

    for event in events:

        print(
            f"{fmt_time(event.time)} | "
            f"{event.event:<25} | "
            f"{event.direction:<4} | "
            f"{fmt_price(event.price)}"
        )


# ================================================================
# FINAL SIGNAL
# ================================================================

def final_signal(
    analysis,
    market
):

    # ------------------------------------------------------------
    # Never execute during closed market.
    # ------------------------------------------------------------

    if market["market"] != "OPEN":

        return {
            "signal": "WAIT",
            "reason": "MARKET_CLOSED"
        }

    buy = analysis["BUY"]

    sell = analysis["SELL"]

    # ------------------------------------------------------------
    # BUY
    # ------------------------------------------------------------

    if (
        buy.get("m5") is not None
        and
        buy["m5"].get("state")
        == "ENTRY_READY"
    ):

        return {
            "signal": "BUY",
            "reason": "COMPLETE_SMC_SEQUENCE"
        }

    # ------------------------------------------------------------
    # SELL
    # ------------------------------------------------------------

    if (
        sell.get("m5") is not None
        and
        sell["m5"].get("state")
        == "ENTRY_READY"
    ):

        return {
            "signal": "SELL",
            "reason": "COMPLETE_SMC_SEQUENCE"
        }

    return {
        "signal": "WAIT",
        "reason": "NO_COMPLETE_SMC_SEQUENCE"
    }


