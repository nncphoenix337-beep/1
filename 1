class FastBacktester:

    def __init__(
        self,
        data,
        engines
    ):

        self.data = data

        self.engines = engines

        self.m15 = engines[
            "M15"
        ]

        self.m5 = engines[
            "M5"
        ]

        self.trades = []

        self.trade_id = 0

        self.last_trade_entry_idx = {
            "BUY": -999999,
            "SELL": -999999
        }

        # --------------------------------------------------------
        # Candidate cache
        # --------------------------------------------------------

        self.candidate_cache = {
            "BUY": [],
            "SELL": []
        }

        # --------------------------------------------------------
        # Process only after enough history
        # --------------------------------------------------------

        self.start_idx = max(
            WARMUP_M5,
            0
        )

    # ============================================================
    # FIND ENTRY
    # ============================================================

    def find_entry(
        self,
        current_idx
    ):

        # We only need to inspect the latest
        # valid candidates.

        results = []

        for direction in [
            "BUY",
            "SELL"
        ]:

            candidates = build_m15_candidates(
                self.m15,
                direction,
                current_idx
            )

            if not candidates:

                continue

            # Newest candidate first
            candidates.sort(
                key=lambda c:
                    int(
                        c["displacement"]
                    ),
                reverse=True
            )

            for candidate in candidates:

                poi = candidate[
                    "poi"
                ]

                confirmation = (
                    confirm_m5(
                        self.m5,
                        poi,
                        direction,
                        current_idx
                    )
                )

                if confirmation is None:

                    continue

                retest_idx = int(
                    confirmation[
                        "retest"
                    ]
                )

                # Do not use a retest that is
                # before the replay candle.
                if retest_idx > current_idx:

                    continue

                # Do not repeat same entry.
                if (
                    retest_idx
                    <=
                    self.last_trade_entry_idx[
                        direction
                    ]
                ):

                    continue

                results.append(
                    (
                        retest_idx,
                        direction,
                        candidate,
                        confirmation
                    )
                )

                # The newest valid entry for this
                # direction is enough.
                break

        if not results:

            return None

        # Earliest valid signal
        results.sort(
            key=lambda x: int(
                x[0]
            )
        )

        return results[0]

    # ============================================================
    # RUN
    # ============================================================

    def run(self):

        print()
        print("=" * 72)
        print("SMC BACKTEST V4.4.1 FAST")
        print("=" * 72)

        print(
            f"M5 candles : "
            f"{len(self.m5.df):,}"
        )

        print(
            f"Warmup     : "
            f"{self.start_idx:,}"
        )

        print()
        print(
            "Calculating SMC engine only ONCE..."
        )

        started = time.time()

        # --------------------------------------------------------
        # Replay
        # --------------------------------------------------------

        total = len(
            self.m5.df
        )

        for current_idx in range(
            self.start_idx,
            total
        ):

            # ----------------------------------------------------
            # Current candle is available only after close.
            # ----------------------------------------------------

            if current_idx <= 0:

                continue

            signal_time = (
                self.m5.df.iloc[
                    current_idx
                ]["time"]
            )

            result = self.find_entry(
                current_idx
            )

            if result is None:

                continue

            (
                retest_idx,
                direction,
                candidate,
                confirmation
            ) = result

            # ----------------------------------------------------
            # Entry must be known at current replay time
            # ----------------------------------------------------

            if retest_idx > current_idx:

                continue

            # ----------------------------------------------------
            # Create trade
            # ----------------------------------------------------

            self.trade_id += 1

            trade = create_trade(
                self.trade_id,
                direction,
                signal_time,
                self.m5,
                self.m15,
                candidate,
                confirmation
            )

            if trade is None:

                continue

            # ----------------------------------------------------
            # Future starts AFTER retest candle.
            # ----------------------------------------------------

            future_start = (
                retest_idx + 1
            )

            if (
                future_start
                >=
                len(self.m5.df)
            ):

                continue

            trade = simulate_trade(
                trade,
                self.m5,
                future_start
            )

            self.trades.append(
                trade
            )

            self.last_trade_entry_idx[
                direction
            ] = retest_idx

            print_trade(
                trade
            )

            # ----------------------------------------------------
            # Max trades
            # ----------------------------------------------------

            if (
                MAX_TRADES > 0
                and
                len(self.trades)
                >= MAX_TRADES
            ):

                break

            # ----------------------------------------------------
            # Progress
            # ----------------------------------------------------

            if (
                current_idx
                %
                500
                ==
                0
            ):

                progress = (
                    current_idx
                    /
                    max(
                        1,
                        total - 1
                    )
                ) * 100.0

                print(
                    f"\rProgress "
                    f"{progress:6.2f}% | "
                    f"Trades "
                    f"{len(self.trades):5d}",
                    end=""
                )

        elapsed = (
            time.time()
            -
            started
        )

        print()

        print(
            f"\nReplay selesai "
            f"dalam {elapsed:.2f} detik."
        )

        return self.trades


