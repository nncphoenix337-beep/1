# ================================================================
# STATISTICS
# ================================================================

def calculate_stats(
    trades
):

    if not trades:

        return {}

    df = pd.DataFrame(
        [
            asdict(
                trade
            )
            for trade in trades
        ]
    )

    result = pd.to_numeric(
        df["result_r"],
        errors="coerce"
    ).fillna(0.0)

    wins = (
        result > 0
    )

    losses = (
        result < 0
    )

    be = (
        result == 0
    )

    total = len(
        result
    )

    win_count = int(
        wins.sum()
    )

    loss_count = int(
        losses.sum()
    )

    be_count = int(
        be.sum()
    )

    gross_profit = float(
        result[
            result > 0
        ].sum()
    )

    gross_loss = abs(
        float(
            result[
                result < 0
            ].sum()
        )
    )

    if gross_loss > 0:

        pf = (
            gross_profit
            /
            gross_loss
        )

    else:

        pf = float(
            "inf"
        )

    equity = (
        result.cumsum()
    )

    peak = (
        equity.cummax()
    )

    drawdown = (
        equity
        -
        peak
    )

    max_dd = float(
        drawdown.min()
    )

    buy = df[
        df["direction"] == "BUY"
    ]

    sell = df[
        df["direction"] == "SELL"
    ]

    def side(
        data
    ):

        if data.empty:

            return {
                "trades": 0,
                "wr": 0.0,
                "net_r": 0.0,
                "expectancy": 0.0
            }

        r = pd.to_numeric(
            data["result_r"],
            errors="coerce"
        ).fillna(0.0)

        return {
            "trades":
                len(r),

            "wr":
                (
                    r > 0
                ).mean()
                * 100.0,

            "net_r":
                r.sum(),

            "expectancy":
                r.mean()
        }

    return {

        "total":
            total,

        "wins":
            win_count,

        "losses":
            loss_count,

        "breakeven":
            be_count,

        "win_rate":
            (
                win_count
                /
                total
                *
                100.0
            ),

        "net_r":
            result.sum(),

        "gross_profit":
            gross_profit,

        "gross_loss":
            gross_loss,

        "profit_factor":
            pf,

        "expectancy":
            result.mean(),

        "max_dd":
            max_dd,

        "tp1":
            int(
                df["tp1_hit"].sum()
            ),

        "tp2":
            int(
                df["tp2_hit"].sum()
            ),

        "tp3":
            int(
                df["tp3_hit"].sum()
            ),

        "sl":
            int(
                df["sl_hit"].sum()
            ),

        "buy":
            side(buy),

        "sell":
            side(sell)
    }


