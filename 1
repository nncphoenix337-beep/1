# ================================================================

def save_trades(
    trades
):

    if not trades:

        return None

    path = os.path.join(
        RESULT_DIR,
        "smc_backtest_v441.csv"
    )

    df = pd.DataFrame(
        [
            asdict(
                trade
            )
            for trade in trades
        ]
    )

    df.to_csv(
        path,
        index=False
    )

    print()
    print(
        "Trade log:"
    )

    print(
        path
    )

    return path


